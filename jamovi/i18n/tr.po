#: R/diagnosticmeta.b.R
msgid "- descriptive only: too many zero cells for a valid asymmetry test"
msgstr ""

#: R/waterfall.b.R
msgid "(%d of %d evaluable patients achieved complete or partial response)"
msgstr "(%d / %d değerlendirilebilir hasta tam veya kısmi yanıt elde etti)"

#: R/waterfall.b.R
msgid "(%d of %d evaluable patients achieved response or stable disease)"
msgstr "(%d / %d değerlendirilebilir hasta yanıt veya kararlı hastalık elde etti)"

#: R/ihcheterogeneity.b.R
msgid "(1 × % weak) + (2 × % moderate) + (3 × % strong) staining; range 0 to 300."
msgstr ""
"(1 × zayıf boyanma yüzdesi) + (2 × orta boyanma yüzdesi) + (3 × güçlü "
"boyanma yüzdesi); aralık 0 ile 300 arası."

#: R/swimmerplot-html.R
msgid "(numeric days/months/years)"
msgstr "(sayısal gün/ay/yıl)"

#: R/swimmerplot.b.R
msgid ""
"{n} of {N} patients have no recorded response and are not shown here, so "
"these rows sum to {shown} of the {total} {unit} of total person-time "
"reported in the summary."
msgstr ""

#: R/swimmerplot.b.R
msgid "{response} Rate ({n}/{N})"
msgstr ""

#: diagnosticmeta/ui[1][1][0]/confidence_level.suffix
msgid "%"
msgstr "%"

#: waterfall/results/personTimeTable.columns.title
msgid "% Patients"
msgstr "% Hasta"

#: waterfall/results/personTimeTable.columns.title
msgid "% Time"
msgstr "% Zaman"

#: R/waterfall.b.R
msgid "%.1f %s (%s; %d of %d responders progressed)"
msgstr "%.1f %s (%s; %d / %d yanıt veren hastada progresyon gelişti)"

#: R/swimmerplot.b.R
msgid "%.1f %s (95%% CI %s)"
msgstr ""

#: R/waterfall.b.R
msgid "%.1f %s (n=%d responders)"
msgstr "%.1f %s (n=%d yanıt veren)"

#: R/waterfall.b.R
msgid "%.1f%% (%d of %d evaluable patients achieved complete or partial response)"
msgstr "%%%.1f (%d / %d değerlendirilebilir hasta tam veya kısmi yanıt elde etti)"

#: R/waterfall.b.R
msgid "%.1f%% (%d of %d evaluable patients achieved response or stable disease)"
msgstr ""
"%%%.1f (%d / %d değerlendirilebilir hasta yanıt veya kararlı hastalık elde "
"etti)"

#: R/waterfall.b.R
msgid "%.1f%% (95%% CI %.1f-%.1f%%)"
msgstr "%%%.1f (%%95 GA %%%.1f-%.1f)"

#: R/ihcheterogeneity.b.R
msgid "%+.1f%% of the reference mean"
msgstr "Referans ortalamasına göre %%%+.1f"

#: R/ihcheterogeneity.b.R
msgid "%+.1f%% of the reference mean (other compartments: %+.1f%%)"
msgstr "Referans ortalamasına göre %%%+.1f (diğer kompartmanlar: %%%+.1f)"

#: R/swimmerplot.b.R
msgid "%d after the patient's last end"
msgstr ""

#: R/swimmerplot.b.R
msgid "%d before the patient's first start"
msgstr ""

#: R/ihcheterogeneity.b.R
msgid "%d case(s) whose mean is 0 were left out, because their CV is undefined."
msgstr "Ortalaması 0 olan %d vaka, CV'leri tanımsız olduğu için dışarıda bırakıldı."

#: R/ihcheterogeneity.b.R
msgid ""
"%d case(s) whose mean is below %s (2%% of the 95th percentile of all values) "
"were left out, because the CV is unstable near zero; %d of them had "
"identical measurements."
msgstr ""
"%d vaka dışarıda bırakıldı: ortalamaları %s değerinin (tüm değerlerin 95. "
"yüzdeliğinin %%2'si) altındaydı ve CV sıfıra yakın değerlerde kararsızdır; "
"bunların %d tanesinde ölçümler aynıydı."

#: R/ihcheterogeneity.b.R
msgid "%d case(s) with a mean near zero are not shown: their CV is unstable."
msgstr "Ortalaması sıfıra yakın %d vaka gösterilmiyor: CV'leri kararsızdır."

#: R/ihcheterogeneity.b.R
msgid "%d case(s) with a mean near zero have no CV and are not in the CV tests."
msgstr ""
"Ortalaması sıfıra yakın %d vakanın CV'si yoktur ve bu vakalar CV testlerine "
"dahil edilmemiştir."

#: R/ihcheterogeneity.b.R
msgid "%d case(s) with an incomplete set of measurements were excluded."
msgstr "Eksik ölçüm setine sahip %d vaka hariç tutuldu."

#: R/ihcheterogeneity.b.R
msgid ""
"%d cases with a reference measurement and at least one of %d regional "
"measurements."
msgstr "Referans ölçümü ve %2$d bölgesel ölçümden en az biri bulunan %1$d vaka."

#: R/ihcheterogeneity.b.R
msgid "%d cases with a reference measurement and one regional measurement."
msgstr "Referans ölçümü ve bir bölgesel ölçümü bulunan %d vaka."

#: R/ihcheterogeneity.b.R
msgid "%d cases with at least two of %d regional measurements."
msgstr "%2$d bölgesel ölçümden en az ikisi bulunan %1$d vaka."

#: R/ihcheterogeneity.b.R
msgid "%d cases with both regional measurements."
msgstr "Her iki bölgesel ölçümü de bulunan %d vaka."

#: R/ihcheterogeneity.b.R
msgid ""
"%d cases without a Spatial Region ID are left out of the compartment "
"analysis."
msgstr ""
"Uzamsal Bölge Kimliği olmayan %d vaka kompartman analizinin dışında "
"bırakıldı."

#: R/swimmerplot.b.R
msgid "%d for patients not in the analysis"
msgstr ""

#: R/swimmerplot.b.R
msgid ""
"%d had a start or end that could not be read with the selected Date Format "
"(%s)."
msgstr ""

#: R/swimmerplot.b.R
msgid "%d had a start or end that is not a number."
msgstr ""

#: R/swimmerplot.b.R
msgid "%d had an end time before the start time."
msgstr ""

#: R/swimmerplot.b.R
msgid "%d had no patient ID."
msgstr ""

#: R/swimmerplot.b.R
msgid "%d had no start or end time."
msgstr ""

#: R/swimmerplot.b.R
msgid ""
"%d of %d censoring/event values could not be interpreted; those patients are "
"treated as completed follow-up (events) in the reverse Kaplan-Meier estimate "
"and receive no status arrow. Use 0/FALSE/no/censored/alive for ongoing and "
"1/TRUE/yes/event/dead for completed."
msgstr ""

#: R/swimmerplot.b.R
msgid ""
"%d of %d event markers are not shown (%s). The Event Marker Summary counts "
"and percentages below describe only the %d markers that fall inside a "
"patient's timeline. Events recorded after follow-up ends, such as death, "
"need an end time that covers them."
msgstr ""

#: R/swimmerplot.b.R
msgid ""
"%d of %d milestone values fall outside the patient's own start-to-end window "
"(%s). They are still drawn and still counted in the Milestone Event Summary, "
"so its median and range include times the timeline does not cover. Check "
"that the milestone variable is measured on the same clock as Start Time and "
"End Time."
msgstr ""

#: R/waterfall.b.R
msgid ""
"%d of %d non-zero response values lie strictly between -1 and 1, while the "
"others look like percentages. If some rows were entered as proportions "
"(-0.35 for -35%%), multiply those rows by 100."
msgstr ""
"Sıfır olmayan %d / %d yanıt değeri kesin olarak -1 ile 1 arasındadır, "
"diğerleri ise yüzde gibi görünmektedir. Bazı satırlar oran olarak girildiyse "
"(-%%35 için -0.35), bu satırları 100 ile çarpın."

#: R/swimmerplot.b.R
msgid ""
"%d of %d patients have no censoring/event value. They are excluded from the "
"reverse Kaplan-Meier median follow-up rather than counted as completed "
"follow-up, which would bias it downward. Their timelines are still drawn, "
"without a status arrow."
msgstr ""

#: R/swimmerplot.b.R
msgid ""
"%d of %d patients have no value in the grouping variable and are excluded "
"from this comparison only. The response rates reported above still cover all "
"%d patients, so the two denominators differ."
msgstr ""

#: R/waterfall.b.R
msgid ""
"%d of %d patients were excluded from the response analysis because a usable "
"baseline could not be established (baseline missing, zero, or non-numeric). "
"Excluded: %s. All rates below are computed over the %d evaluable patients, "
"so they are NOT intention-to-treat."
msgstr ""
"%d / %d hasta, kullanılabilir bir başlangıç değeri belirlenemediği için "
"(başlangıç eksik, sıfır veya sayısal değil) yanıt analizinden hariç tutuldu. "
"Hariç tutulanlar: %s. Aşağıdaki tüm oranlar %d değerlendirilebilir hasta "
"üzerinden hesaplanmıştır, bu nedenle tedavi niyetine göre (ITT) oranlar "
"DEĞİLDİR."

#: R/waterfall.b.R
msgid ""
"%d of %d patients were excluded from the response analysis because they have "
"no non-missing response value. Excluded: %s. All rates below are computed "
"over the %d evaluable patients, so they are NOT intention-to-treat."
msgstr ""
"%d / %d hasta, eksik olmayan bir yanıt değeri bulunmadığı için yanıt "
"analizinden hariç tutuldu. Hariç tutulanlar: %s. Aşağıdaki tüm oranlar %d "
"değerlendirilebilir hasta üzerinden hesaplanmıştır, bu nedenle tedavi "
"niyetine göre (ITT) oranlar DEĞİLDİR."

#: R/swimmerplot.b.R
msgid ""
"%d of %d rows were excluded before analysis. All counts, rates and "
"person-time below are based on the remaining %d rows."
msgstr ""

#: R/ihcheterogeneity.b.R
msgid ""
"%d of %d rows were not analysed because they have fewer than 2 regional "
"measurements."
msgstr "%d / %d satır, 2'den az bölgesel ölçüme sahip olduğu için analiz edilmedi."

#: R/ihcheterogeneity.b.R
msgid ""
"%d of %d rows were not analysed because they lack a reference value or any "
"regional measurement."
msgstr ""
"%d / %d satır, referans değeri veya herhangi bir bölgesel ölçümü olmadığı "
"için analiz edilmedi."

#: R/diagnosticmeta.b.R
msgid ""
"%d of %d studies have a cell below 5. The bivariate model used here "
"approximates the logit sensitivity and specificity as normal, which is "
"biased when cells are that small, and any zero cell additionally needs a "
"continuity correction. Published comparisons put the gap against an exact "
"binomial (generalised linear mixed) model at several percentage points on "
"data like this. Treat the pooled pair as approximate, and confirm it in "
"software offering a binomial bivariate model before relying on it."
msgstr ""

#: R/diagnosticmeta.b.R
msgid ""
"%d of %d studies have fractional counts. Cell counts are numbers of "
"participants; check whether percentages or rates were entered. These studies "
"are excluded."
msgstr ""

#: R/diagnosticmeta.b.R
msgid ""
"%d of %d studies were excluded before analysis (%s). All results below are "
"based on the remaining %d studies."
msgstr ""
"%d / %d çalışma analizden önce hariç tutuldu (%s). Aşağıdaki tüm sonuçlar "
"kalan %d çalışmaya dayanmaktadır."

#: R/diagnosticmeta.b.R
msgid ""
"%d of %d studies were excluded from the meta-regression because the "
"covariate is missing; the pooled estimates above use all %d."
msgstr ""

#: R/ihcheterogeneity.b.R
msgid "%d of these cases have every measurement."
msgstr "Bu vakalardan %d tanesinde tüm ölçümler mevcuttur."

#: R/ihcheterogeneity.b.R
msgid ""
"%d paired comparisons are reported; the p-values test against zero and are "
"unadjusted. With a margin of %s%% of the comparison mean, a difference is "
"ruled out when its 90%% CI lies within the margin (two one-sided tests) and "
"shown to be material when its Bonferroni-adjusted %s%% CI lies entirely "
"beyond the margin; otherwise it is inconclusive."
msgstr ""
"%d eşleştirilmiş karşılaştırma raporlanmıştır; p-değerleri sıfıra karşı test "
"eder ve düzeltilmemiştir. Karşılaştırma ortalamasının %%%s kadarı olan bir "
"marj ile, bir fark %%90 GA'sı marjın içinde kaldığında dışlanır (iki tek "
"yönlü test) ve Bonferroni düzeltmeli %%%s GA'sı tamamen marjın ötesinde "
"kaldığında önemli olduğu gösterilmiş olur; aksi halde sonuç belirsizdir."

#: R/waterfall.b.R
msgid ""
"%d patient(s) had a change below -100%%, which is not physically possible: "
"-100%% already means the tumour has disappeared completely. The most extreme "
"was %.1f%%. These values were capped at -100%% (complete response) for the "
"analysis and the plot: %s. Check the response column for data-entry errors."
msgstr ""
"%d hastada -%%100'ün altında bir değişim vardı, bu fiziksel olarak mümkün "
"değildir: -%%100 zaten tümörün tamamen kaybolduğu anlamına gelir. En uç "
"değer %%%.1f idi. Bu değerler analiz ve grafik için -%%100 (tam yanıt) ile "
"sınırlandırıldı: %s. Veri girişi hataları için yanıt sütununu kontrol edin."

#: R/waterfall.b.R
msgid ""
"%d patient(s) have a baseline but no post-baseline measurement (no later "
"row, or the later measurements are missing) and are therefore not "
"response-evaluable: %s. They are reported as \"Unknown\" rather than as "
"stable disease, so they do not inflate the disease control rate."
msgstr ""
"%d hastada başlangıç değeri var ancak başlangıç sonrası ölçüm yok (sonraki "
"satır yok veya sonraki ölçümler eksik) ve bu nedenle bu hastalar yanıt "
"açısından değerlendirilemez: %s. Bu hastalar kararlı hastalık olarak değil "
"\"Bilinmeyen\" olarak raporlanır, böylece hastalık kontrol oranını "
"şişirmezler."

#: R/waterfall.b.R
msgid ""
"%d patient(s) have a negative raw measurement, which is not a possible "
"tumour size: %s. A negative baseline inverts the sign of the percent change, "
"so a growing tumour would be reported as a response. These patients are "
"reported as \"Unknown\" rather than guessed at. Check the measurement column "
"for data-entry errors."
msgstr ""
"%d hastada olası bir tümör boyutu olmayan negatif bir ham ölçüm var: %s. "
"Negatif bir başlangıç değeri yüzde değişimin işaretini tersine çevirir, "
"böylece büyüyen bir tümör yanıt olarak raporlanabilir. Bu hastalar tahmin "
"edilmek yerine \"Bilinmeyen\" olarak raporlanır. Veri girişi hataları için "
"ölçüm sütununu kontrol edin."

#: R/waterfall.b.R
msgid ""
"%d patient(s) have more than one assessment at the same time point: %s. All "
"of them are used, and the best is taken as the best response. Check for "
"duplicated rows."
msgstr ""
"%d hastada aynı zaman noktasında birden fazla değerlendirme var: %s. "
"Bunların tümü kullanılır ve en iyisi en iyi yanıt olarak alınır. Yinelenen "
"satırları kontrol edin."

#: R/waterfall.b.R
msgid ""
"%d patient(s) have more than one confirmation value across their rows: %s. "
"The first recorded value is used for the marker."
msgstr ""
"%d hastada satırlar arasında birden fazla doğrulama değeri var: %s. İşaretçi "
"için ilk kaydedilen değer kullanılır."

#: R/waterfall.b.R
msgid ""
"%d patient(s) have more than one response category override across their "
"rows: %s. The first recorded value is used. Enter one category per patient."
msgstr ""
"%d hastada satırlar arasında birden fazla yanıt kategorisi geçersiz kılma "
"değeri var: %s. İlk kaydedilen değer kullanılır. Hasta başına bir kategori "
"girin."

#: R/waterfall.b.R
msgid ""
"%d patient(s) have more than one row but no time variable is selected: %s. "
"The smallest value was used as each patient's best response. If the rows are "
"visits, a 0%% baseline row takes part in that minimum, so a tumour that only "
"grew is scored SD instead of PD. Select the visit time as the Time Variable."
msgstr ""
"%d hastada birden fazla satır var ancak zaman değişkeni seçilmedi: %s. Her "
"hastanın en iyi yanıtı olarak en küçük değer kullanıldı. Satırlar vizit ise "
"%%0 değerindeki başlangıç satırı bu minimuma katılır, böylece yalnızca "
"büyüyen bir tümör PD yerine SD olarak sınıflandırılır. Vizit zamanını Zaman "
"Değişkeni olarak seçin."

#: R/waterfall.b.R
msgid ""
"%d patient(s) have more than one value of the group variable across their "
"rows: %s. Each patient is counted once, in the group of their first recorded "
"value. Check the group column."
msgstr ""
"%d hastada satırlar arasında grup değişkeninin birden fazla değeri var: %s. "
"Her hasta, ilk kaydedilen değerinin grubunda bir kez sayılır. Grup sütununu "
"kontrol edin."

#: R/waterfall.b.R
msgid "%d patient(s) not evaluable for response are not included."
msgstr "Yanıt açısından değerlendirilemeyen %d hasta dahil edilmemiştir."

#: R/waterfall.b.R
msgid ""
"%d patient(s) with a missing group value are excluded from the group "
"comparison."
msgstr "Grup değeri eksik olan %d hasta grup karşılaştırmasından hariç tutulmuştur."

#: R/waterfall.b.R
msgid "%d patient(s) with tumor growth >200%% (verify data accuracy)."
msgstr "Tümör büyümesi >%%200 olan %d hasta (veri doğruluğunu onaylayın)."

#: R/waterfall.b.R
msgid "%d patient(s) with tumor shrinkage >100%% (impossible with single lesion)."
msgstr "Tümör küçülmesi >%%100 olan %d hasta (tek lezyonla imkansızdır)."

#: R/swimmerplot.b.R
msgid "%d patients"
msgstr ""

#: R/waterfall.b.R
msgid ""
"%d responder(s) by category override have no measured response time and are "
"not included here."
msgstr ""
"Kategori geçersiz kılma ile yanıt veren olarak belirlenen %d hastanın "
"ölçülmüş bir yanıt zamanı yoktur ve bu hastalar burada dahil edilmemiştir."

#: R/waterfall.b.R
msgid ""
"%d row(s) with no patient ID were excluded from the analysis; they cannot be "
"assigned to a patient. Fill in the patient ID if they belong to a patient."
msgstr ""
"Hasta kimliği olmayan %d satır analizden hariç tutuldu; bu satırlar bir "
"hastaya atanamaz. Bir hastaya aitlerse hasta kimliğini doldurun."

#: R/swimmerplot.b.R
msgid ""
"%d start/end values are not numbers (for example '%s') and those rows are "
"excluded. Time Input Type is set to Raw Values; if these are calendar dates, "
"switch it to Date/Time."
msgstr ""

#: R/diagnosticmeta.b.R
msgid ""
"%d studies were read successfully, but every analysis and display option is "
"switched off, so there is nothing to show. Tick Bivariate random-effects "
"model for the pooled sensitivity and specificity, or any other option under "
"Analysis, Visualization or Reporting."
msgstr ""

#: R/diagnosticmeta.b.R
msgid ""
"%d study identifier(s) appear more than once or are missing (%s). Each row "
"is analysed as its own study and the labels were made unique for the tables "
"and the forest plot."
msgstr ""

#: R/diagnosticmeta.b.R
msgid ""
"%d study/studies contain a zero cell. A continuity correction of 0.5 was "
"applied to all studies so the model could be fitted. Continuity corrections "
"shift the pooled estimate; compare the alternatives under Zero Cell "
"Correction to see how sensitive your result is."
msgstr ""
"%d çalışma sıfır hücresi içeriyor. Modelin kurulabilmesi için tüm "
"çalışmalara 0.5 süreklilik düzeltmesi uygulandı. Süreklilik düzeltmeleri "
"havuzlanmış tahmini kaydırır; sonucunuzun ne kadar duyarlı olduğunu görmek "
"için Sıfır Hücre Düzeltmesi altındaki alternatifleri karşılaştırın."

#: R/diagnosticmeta.b.R
msgid ""
"%d study/studies contain a zero cell. A continuity correction of 0.5 was "
"applied to those studies only so the model could be fitted. Continuity "
"corrections shift the pooled estimate; compare the alternatives under Zero "
"Cell Correction to see how sensitive your result is."
msgstr ""
"%d çalışma sıfır hücresi içeriyor. Modelin kurulabilmesi için yalnızca bu "
"çalışmalara 0.5 süreklilik düzeltmesi uygulandı. Süreklilik düzeltmeleri "
"havuzlanmış tahmini kaydırır; sonucunuzun ne kadar duyarlı olduğunu görmek "
"için Sıfır Hücre Düzeltmesi altındaki alternatifleri karşılaştırın."

#: R/diagnosticmeta.b.R
msgid ""
"%d study/studies contain a zero cell. No user correction is selected, so "
"mada's default single-study 0.5 correction is applied inside the bivariate "
"model only: the univariate heterogeneity and meta-regression models exclude "
"those studies instead, so they rest on fewer studies than the pooled "
"estimates. Choose a Zero-Cell Correction option to keep every study in every "
"model."
msgstr ""

#: R/diagnosticmeta.b.R
msgid "%d with missing counts"
msgstr "%d tanesinde eksik sayımlar var"

#: R/diagnosticmeta.b.R
msgid "%d with negative counts"
msgstr "%d tanesinde negatif sayımlar var"

#: R/diagnosticmeta.b.R
msgid "%d with no diseased or no non-diseased participants"
msgstr "%d tanesinde hastalıklı veya hastalıksız katılımcı yok"

#: R/swimmerplot.b.R
msgid "%d with no event time"
msgstr ""

#: R/swimmerplot.b.R
msgid "%d with no event type"
msgstr ""

#: R/swimmerplot.b.R
msgid "%s (cumulative)"
msgstr "%s (kümülatif)"

#: R/ihcheterogeneity.b.R
msgid "%s (reference)"
msgstr "%s (referans)"

#: R/diagnosticmeta.b.R
msgid ""
"%s A new study is predicted to fall between %.1f%% and %.1f%% for "
"sensitivity and between %.1f%% and %.1f%% for specificity."
msgstr ""

#: R/ihcheterogeneity.b.R
msgid ""
"%s is the reference measurement and was also selected as a regional "
"measurement; it is analysed as the reference only."
msgstr ""
"%s referans ölçümüdür ve ayrıca bölgesel ölçüm olarak da seçilmiştir; "
"yalnızca referans olarak analiz edilir."

#: R/diagnosticmeta.b.R
msgid ""
"%s meta-regression not run: after excluding studies this model cannot use, "
"the covariate takes the same value in every remaining study."
msgstr ""

#: R/diagnosticmeta.b.R
msgid ""
"%s meta-regression not run: the %d studies this model can use cannot support "
"a covariate contributing %d model parameter(s) - no residual degrees of "
"freedom remain, so the model would fit perfectly and its confidence "
"intervals would be meaningless. At least %d studies are needed, and 10 per "
"covariate is the usual recommendation."
msgstr ""

#: R/diagnosticmeta.b.R
msgid ""
"%s meta-regression on %d studies with a covariate contributing %d model "
"parameter(s) (%d residual degrees of freedom). The usual recommendation is "
"at least 10 studies per covariate, so estimates may be unstable and "
"confidence intervals unreliable. Report this as exploratory only."
msgstr ""

#: R/diagnosticmeta.b.R
msgid "%s Positive LR %.2f and negative LR %.2f."
msgstr "%s Pozitif OO %.2f ve negatif OO %.2f."

#: R/ihcheterogeneity.b.R
msgid "%s vs %s"
msgstr "%s ve %s"

#: R/ihcheterogeneity.b.R
msgid "%s vs mean of the other regions"
msgstr "%s ve diğer bölgelerin ortalaması"

#: R/ihcheterogeneity.b.R
msgid "%s vs reference"
msgstr "%s ve referans"

#: R/ihcheterogeneity.b.R
msgid ""
"%s was selected more than once as a regional measurement and is analysed "
"once."
