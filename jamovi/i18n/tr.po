#: R/diagnosticmeta.b.R
msgid ""
"With %.1f%% sensitivity, approximately %.0f out of 100 diseased patients "
"will be correctly identified."
msgstr ""
"%%%.1f duyarlılık ile, hastalıklı 100 hastadan yaklaşık %.0f tanesi doğru "
"olarak tanımlanacaktır."

#: R/diagnosticmeta.b.R
msgid ""
"With %.1f%% sensitivity, this test will detect %.0f out of 1,000 patients "
"with disease, missing only %.0f."
msgstr ""
"%%%.1f duyarlılıkla bu test, hastalığı olan her 1.000 hastadan %.0f tanesini "
"saptar ve yalnızca %.0f tanesini kaçırır."

#: R/diagnosticmeta.b.R
msgid ""
"With %.1f%% sensitivity, this test will detect %.0f out of 100 patients with "
