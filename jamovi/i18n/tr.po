msgid "Deeks' asymmetry test: t = %.2f on %d df, %s"
msgstr "Deeks asimetri testi: t = %.2f, %d sd, %s"

#: R/diagnosticmeta.b.R
msgid ""
"Deeks' asymmetry test: t = %.2f on %d df, %s. Descriptive only: k = %d < 10 "
"gives low statistical power."
msgstr ""
"Deeks asimetri testi: t = %.2f, %d sd, %s. Yalnızca tanımlayıcıdır: k = %d < "
"10 düşük istatistiksel güç verir."

#: R/diagnosticmeta.b.R
msgid ""
