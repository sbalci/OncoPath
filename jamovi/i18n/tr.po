msgstr "NR"

#: R/swimmerplot.b.R
#: waterfall/results/summaryTable.columns.title
msgid "Number of Patients"
msgstr "Hasta Sayısı"

#: R/swimmerplot.b.R
msgid ""
"Number of patients per 100 units of observation time, i.e. 100 divided by "
"the mean person-time per patient. It is not an event rate. Note it divides "
"by person-time (the union of treatment episodes), not by Mean Duration, "
"which spans first start to last end and so includes any gaps."
msgstr ""
"100 gözlem zamanı birimi başına hasta sayısı; hasta başına ortalama "
"kişi-zamanın 100'e bölümünün tersidir. Olay hızı değildir. İlk başlangıçtan "
"son bitişe uzanarak boşlukları içeren ortalama süreye değil, tedavi "
"dönemlerinin birleşimi olan kişi-zamana bölünür."

#: R/swimmerplot-html.R
msgid "numeric values"
msgstr "sayısal değerler"

#: R/swimmerplot.b.R
msgid "Objective response by group - %s."
msgstr "Gruba göre objektif yanıt - %s."

#: R/waterfall.b.R
msgid "Objective Response Rate (CR+PR)"
msgstr "Objektif Yanıt Oranı (CR+PR)"

#: R/swimmerplot.b.R
#: R/waterfall.b.R
msgid "Objective Response Rate (ORR)"
msgstr "Objektif Yanıt Oranı (ORR)"

#: R/waterfall.b.R
msgid "Objective Response Rate (ORR):"
msgstr "Objektif Yanıt Oranı (ORR):"

#: R/waterfall.b.R
msgid ""
"Objective Response Rate, all %d patients (not evaluable counted as "
"non-responders)"
msgstr ""
"Objektif Yanıt Oranı, tüm %d hasta (değerlendirilemeyenler yanıt vermeyen "
"olarak sayıldı)"

#: R/ihcheterogeneity.b.R
