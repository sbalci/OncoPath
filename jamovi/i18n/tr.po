msgstr "Vaka içi CV = %%%s (Düşük değişkenlik)"

#: R/ihcheterogeneity.b.R
msgid "Within-case CV = %s%% (Moderate variability)"
msgstr "Vaka içi CV = %%%s (Orta değişkenlik)"

#: R/ihcheterogeneity.b.R
