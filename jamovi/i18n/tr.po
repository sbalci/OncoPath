msgstr "YAPILACAK"

#: R/ihcheterogeneity.b.R
msgid "Too few cases have paired regional measurements to compare the regions."
msgstr ""
"Bölgeleri karşılaştırmak için eşleştirilmiş bölgesel ölçümlere sahip vaka "
"sayısı çok azdır."

#: R/waterfall.b.R
msgid "Tool automatically calculates percent changes"
msgstr "Araç yüzde değişimlerini otomatik olarak hesaplar"

#: R/waterfall.b.R
msgid "Total"
msgstr "Toplam"

#: R/swimmerplot.b.R
msgid ""
"Total follow-up exceeds 10 years for %d of %d patients. Consider checking "
"data accuracy or using different time units."
msgstr ""
"%d/%d hastada toplam izlem 10 yılı aşmaktadır. Veri doğruluğunu veya farklı "
"zaman birimi kullanımını kontrol edin."

#: R/swimmerplot.b.R
msgid "Total observation time across all patients"
msgstr "Tüm hastalar genelinde toplam gözlem süresi"

